# fail2ban jail：1 小时内累计 5 次登录失败 → 封该 IP 的 HTTPS TCP/UDP 443 端口 24 小时。
[homepage-auth]
enabled  = true
filter   = homepage-auth
logpath  = /home/wyw/homepage/logs/auth.log
findtime = 3600
maxretry = 5
bantime  = 86400
action   = iptables-multiport[name=homepage-auth-tcp, port="443", protocol="tcp"]
           iptables-multiport[name=homepage-auth-udp, port="443", protocol="udp"]

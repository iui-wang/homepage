# homepage 启动配置示例。复制为 config.toml 后修改。
[server]
host = "0.0.0.0"
port = 80

[security]
# Flask 会话签名密钥，用 `python -c "import secrets;print(secrets.token_hex(32))"` 生成。
secret_key = "CHANGE_ME_RANDOM_HEX"
# admin 初始密码（明文）。首次启动据此创建 admin 账号。
admin_initial_password = "CHANGE_ME_STRONG_PASSWORD"

[paths]
db = "/root/homepage/data/homepage.db"
auth_log = "/root/homepage/logs/auth.log"
